{% # theme-check-disable ValidScopedCSSClass %}
{% # theme-check-disable ImgLazyLoading %}

{%- liquid
  assign section_id = section.id
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign cta_label = section.settings.cta_label
  assign cta_url = section.settings.cta_url
  assign layout = section.settings.layout
  assign show_price = section.settings.show_price
  assign show_badge = section.settings.show_badge
-%}

<section
  class="lookbook-masonry lookbook-masonry--{{ section_id }}"
  aria-label="{{ heading | escape }}"
>
  {%- if heading != blank or subheading != blank -%}
    <div class="lookbook-masonry__header page-width">
      {%- if subheading != blank -%}
        <p class="lookbook-masonry__eyebrow">{{ subheading }}</p>
      {%- endif -%}
      <div class="lookbook-masonry__header-row">
        {%- if heading != blank -%}
          <h2 class="lookbook-masonry__heading">{{ heading }}</h2>
        {%- endif -%}
        {%- if cta_label != blank and cta_url != blank -%}
          <a href="{{ cta_url }}" class="lookbook-masonry__header-link">
            {{ cta_label }}
            <span class="lookbook-masonry__arrow" aria-hidden="true">→</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="lookbook-masonry__grid page-width lookbook-masonry__grid--{{ layout }}">
    {%- for block in section.blocks -%}
      {%- if block.type == 'lookbook_product' -%}
        {%- liquid
          assign item_product = block.settings.product
          assign item_image = block.settings.image
          assign item_size = block.settings.size
          assign item_label = block.settings.label
          assign item_link = item_product.url | default: block.settings.link_url

          if item_image != blank
            assign display_image = item_image
          elsif item_product != blank and item_product.featured_image != blank
            assign display_image = item_product.featured_image
          else
            assign display_image = null
          endif

          if item_product != blank
            assign display_title = item_product.title
            assign display_price = item_product.price_min
            assign display_vendor = item_product.vendor
          else
            assign display_title = block.settings.title_override
            assign display_price = null
            assign display_vendor = block.settings.vendor_override
          endif
        -%}

        href="{{ item_link | default: '#' }}" class="lookbook-card lookbook-card--{{ item_size }} lookbook-card--
        {{- block.id -}}
        "
        {{ block.shopify_attributes }}
        aria-label="{{ display_title | escape }}" >
        <div class="lookbook-card__media">
          {%- if display_image != blank -%}
            {%- liquid
              case item_size
                when 'large'
                  assign img_width = 900
                when 'medium'
                  assign img_width = 600
                else
                  assign img_width = 420
              endcase
              assign img_height = img_width | divided_by: display_image.aspect_ratio | round
            -%}
            <img
              src="{{ display_image | image_url: width: img_width }}"
              srcset="
                {{ display_image | image_url: width: 400 }} 400w,
                {{ display_image | image_url: width: 600 }} 600w,
                {{ display_image | image_url: width: 900 }} 900w,
                {{ display_image | image_url: width: 1200 }} 1200w
              "
              sizes="
                (max-width: 749px) 100vw,
                {%- if item_size == 'large' -%}55vw{%- elsif item_size == 'medium' -%}40vw{%- else -%}28vw{%- endif -%}
              "
              alt="{{ display_image.alt | default: display_title | escape }}"
              width="{{ img_width }}"
              height="{{ img_height }}"
              loading="lazy"
            >
          {%- else -%}
            <div class="lookbook-card__placeholder">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}

          <div class="lookbook-card__overlay"></div>

          {%- if show_badge and item_label != blank -%}
            <span class="lookbook-card__badge">{{ item_label }}</span>
          {%- endif -%}
        </div>

        <div class="lookbook-card__info">
          <div class="lookbook-card__info-left">
            {%- if display_vendor != blank -%}
              <p class="lookbook-card__vendor">{{ display_vendor }}</p>
            {%- endif -%}
            {%- if display_title != blank -%}
              <p class="lookbook-card__title">{{ display_title }}</p>
            {%- endif -%}
          </div>
          {%- if show_price and display_price != null -%}
            <p class="lookbook-card__price">{{ display_price | money }}</p>
          {%- endif -%}
        </div>
        </a>

      {%- elsif block.type == 'editorial_card' -%}
        <div
          class="lookbook-editorial lookbook-editorial--{{ block.settings.size }} lookbook-editorial--{{ block.id }}"
          style="
            --editorial-bg: {{ block.settings.background_color | default: '#111111' }};
            --editorial-text: {{ block.settings.text_color | default: '#ffffff' }};
          "
          {{ block.shopify_attributes }}
        >
          <div class="lookbook-editorial__inner">
            {%- if block.settings.eyebrow != blank -%}
              <p class="lookbook-editorial__eyebrow">{{ block.settings.eyebrow }}</p>
            {%- endif -%}
            {%- if block.settings.headline != blank -%}
              <p class="lookbook-editorial__headline">{{ block.settings.headline }}</p>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <p class="lookbook-editorial__body">{{ block.settings.body }}</p>
            {%- endif -%}
            {%- if block.settings.cta_label != blank and block.settings.cta_url != blank -%}
              <a href="{{ block.settings.cta_url }}" class="lookbook-editorial__cta">
                {{ block.settings.cta_label }}
                <span aria-hidden="true">→</span>
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}

    {%- if section.blocks.size == 0 -%}
      {%- for i in (1..5) -%}
        {%- assign placeholder_sizes = 'large,small,small,medium,medium' | split: ',' -%}
        {%- assign placeholder_size = placeholder_sizes[forloop.index0] -%}
        <div class="lookbook-card lookbook-card--{{ placeholder_size }} lookbook-card--placeholder">
          <div class="lookbook-card__media">
            <div class="lookbook-card__placeholder">
              {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <div class="lookbook-card__overlay"></div>
          </div>
          <div class="lookbook-card__info">
            <div class="lookbook-card__info-left">
              <p class="lookbook-card__vendor">Brand Name</p>
              <p class="lookbook-card__title">Product Name</p>
            </div>
            <p class="lookbook-card__price">R 0.00</p>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .lookbook-masonry {
    padding-block: var(--section-padding-top, 60px) var(--section-padding-bottom, 60px);
  }

  .lookbook-masonry__header {
    margin-bottom: 32px;
  }

  .lookbook-masonry__eyebrow {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.5;
    margin: 0 0 10px;
  }

  .lookbook-masonry__header-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .lookbook-masonry__heading {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0;
    line-height: 1.1;
  }

  .lookbook-masonry__header-link {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
    transition: opacity 0.2s ease;
  }

  .lookbook-masonry__header-link:hover {
    opacity: 0.6;
  }

  .lookbook-masonry__arrow {
    transition: transform 0.2s ease;
  }

  .lookbook-masonry__header-link:hover .lookbook-masonry__arrow {
    transform: translateX(3px);
  }

  .lookbook-masonry__grid {
    display: grid;
    gap: 12px;
  }

  .lookbook-masonry__grid--editorial {
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: 220px;
  }

  .lookbook-masonry__grid--classic {
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 280px;
  }

  /* Editorial sizing */
  .lookbook-masonry__grid--editorial .lookbook-card--large,
  .lookbook-masonry__grid--editorial .lookbook-editorial--large {
    grid-column: span 7;
    grid-row: span 2;
  }

  .lookbook-masonry__grid--editorial .lookbook-card--medium,
  .lookbook-masonry__grid--editorial .lookbook-editorial--medium {
    grid-column: span 5;
    grid-row: span 2;
  }

  .lookbook-masonry__grid--editorial .lookbook-card--small,
  .lookbook-masonry__grid--editorial .lookbook-editorial--small {
    grid-column: span 5;
    grid-row: span 1;
  }

  /* Classic sizing */
  .lookbook-masonry__grid--classic .lookbook-card--large,
  .lookbook-masonry__grid--classic .lookbook-editorial--large {
    grid-column: span 2;
    grid-row: span 2;
  }

  .lookbook-masonry__grid--classic .lookbook-card--medium,
  .lookbook-masonry__grid--classic .lookbook-editorial--medium {
    grid-column: span 1;
    grid-row: span 2;
  }

  .lookbook-masonry__grid--classic .lookbook-card--small,
  .lookbook-masonry__grid--classic .lookbook-editorial--small {
    grid-column: span 1;
    grid-row: span 1;
  }

  .lookbook-card {
    position: relative;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    border-radius: 4px;
    background: #f5f5f5;
  }

  .lookbook-card__media {
    position: relative;
    flex: 1;
    overflow: hidden;
  }

  .lookbook-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.55s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .lookbook-card:hover .lookbook-card__media img {
    transform: scale(1.04);
  }

  .lookbook-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ebebeb;
  }

  .lookbook-card__placeholder .placeholder-svg {
    width: 60px;
    height: 60px;
    opacity: 0.3;
  }

  .lookbook-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 40%, rgba(0, 0, 0, 0.38) 100%);
    pointer-events: none;
  }

  .lookbook-card__badge {
    position: absolute;
    top: 14px;
    left: 14px;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: #fff;
    color: #111;
    padding: 4px 8px;
    border-radius: 2px;
    line-height: 1;
  }

  .lookbook-card__info {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 8px;
    padding: 12px 14px;
    background: #fff;
    border-top: 1px solid #f0f0f0;
  }

  .lookbook-card__info-left {
    min-width: 0;
    flex: 1;
  }

  .lookbook-card__vendor {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.45;
    margin: 0 0 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .lookbook-card__title {
    font-size: 0.8125rem;
    font-weight: 600;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    letter-spacing: -0.01em;
  }

  .lookbook-card__price {
    font-size: 0.8125rem;
    font-weight: 700;
    margin: 0;
    white-space: nowrap;
    letter-spacing: -0.01em;
    flex-shrink: 0;
  }

  .lookbook-editorial {
    background-color: var(--editorial-bg);
    color: var(--editorial-text);
    border-radius: 4px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .lookbook-editorial__inner {
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
  }

  .lookbook-editorial__eyebrow {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.55;
    margin: 0;
  }

  .lookbook-editorial__headline {
    font-size: clamp(1.25rem, 2.5vw, 1.875rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin: 0;
  }

  .lookbook-editorial__body {
    font-size: 0.8125rem;
    line-height: 1.55;
    opacity: 0.75;
    margin: 0;
    max-width: 28ch;
  }

  .lookbook-editorial__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
    margin-top: 4px;
    width: fit-content;
    transition: opacity 0.2s ease;
  }

  .lookbook-editorial__cta:hover {
    opacity: 0.65;
  }

  @media screen and (max-width: 749px) {
    .lookbook-masonry__grid--editorial,
    .lookbook-masonry__grid--classic {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 200px;
    }

    .lookbook-masonry__grid--editorial .lookbook-card--large,
    .lookbook-masonry__grid--editorial .lookbook-editorial--large,
    .lookbook-masonry__grid--classic .lookbook-card--large,
    .lookbook-masonry__grid--classic .lookbook-editorial--large {
      grid-column: span 2;
      grid-row: span 2;
    }

    .lookbook-masonry__grid--editorial .lookbook-card--medium,
    .lookbook-masonry__grid--editorial .lookbook-editorial--medium,
    .lookbook-masonry__grid--classic .lookbook-card--medium,
    .lookbook-masonry__grid--classic .lookbook-editorial--medium {
      grid-column: span 2;
      grid-row: span 1;
    }

    .lookbook-masonry__grid--editorial .lookbook-card--small,
    .lookbook-masonry__grid--editorial .lookbook-editorial--small,
    .lookbook-masonry__grid--classic .lookbook-card--small,
    .lookbook-masonry__grid--classic .lookbook-editorial--small {
      grid-column: span 1;
      grid-row: span 1;
    }

    .lookbook-masonry__header-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }

    .lookbook-editorial__headline {
      font-size: 1.125rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lookbook-card__media img,
    .lookbook-masonry__arrow {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Lookbook",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Drop"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Eyebrow label",
      "default": "New Arrivals"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Link label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Link URL"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Grid layout",
      "options": [
        { "value": "editorial", "label": "Editorial (asymmetric)" },
        { "value": "classic", "label": "Classic (3-column)" }
      ],
      "default": "editorial"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show drop badge",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "lookbook_product",
      "name": "Product tile",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Override image",
          "info": "Leave blank to use the product's featured image"
        },
        {
          "type": "select",
          "id": "size",
          "label": "Tile size",
          "options": [
            { "value": "large", "label": "Large (hero)" },
            { "value": "medium", "label": "Medium" },
            { "value": "small", "label": "Small" }
          ],
          "default": "medium"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Badge text",
          "info": "e.g. NEW, LIMITED, COLLAB"
        },
        {
          "type": "text",
          "id": "title_override",
          "label": "Title (if no product)"
        },
        {
          "type": "text",
          "id": "vendor_override",
          "label": "Brand (if no product)"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link (if no product)"
        }
      ]
    },
    {
      "type": "editorial_card",
      "name": "Editorial card",
      "settings": [
        {
          "type": "select",
          "id": "size",
          "label": "Card size",
          "options": [
            { "value": "large", "label": "Large" },
            { "value": "medium", "label": "Medium" },
            { "value": "small", "label": "Small" }
          ],
          "default": "small"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Just Dropped"
        },
        {
          "type": "textarea",
          "id": "headline",
          "label": "Headline",
          "default": "Township Drip. No Limits."
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body text"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label",
          "default": "Shop the drop"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "Button URL"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Background colour",
          "default": "#111111"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text colour",
          "default": "#ffffff"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lookbook",
      "category": "Products",
      "blocks": [
        { "type": "lookbook_product", "settings": { "size": "large", "label": "NEW" } },
        { "type": "lookbook_product", "settings": { "size": "small", "label": "LIMITED" } },
        { "type": "lookbook_product", "settings": { "size": "small" } },
        {
          "type": "editorial_card",
          "settings": {
            "size": "medium",
            "eyebrow": "Just Dropped",
            "headline": "Township Drip. No Limits.",
            "body": "Limited runs. Local heat. Built for the streets.",
            "cta_label": "Shop the drop",
            "background_color": "#111111",
            "text_color": "#ffffff"
          }
        },
        { "type": "lookbook_product", "settings": { "size": "medium" } },
        { "type": "lookbook_product", "settings": { "size": "medium", "label": "COLLAB" } }
      ]
    }
  ]
}
{% endschema %}
