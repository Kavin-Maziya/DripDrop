{%- doc -%}
  Renders a release countdown and notify-me email form on product pages.
  Shows automatically when product is tagged 'coming-soon' or is unavailable.
{%- enddoc -%}

{%- liquid
  assign is_coming_soon = false
  if product.tags contains 'coming-soon'
    assign is_coming_soon = true
  endif

  assign show_notify = false
  if is_coming_soon or product.available == false
    assign show_notify = true
  endif
-%}

{% if show_notify %}
  <div class="drop-notify" {{ block.shopify_attributes }}>
    {% if block.settings.release_date != blank %}
      <div class="drop-notify__countdown">
        <p class="drop-notify__eyebrow">Releasing</p>
        <p class="drop-notify__date">{{ block.settings.release_date }}</p>

        <div
          class="drop-notify__timer"
          id="drop-notify-timer-{{ block.id }}"
          data-release="{{ block.settings.release_date }}"
        >
          <div class="drop-notify__unit">
            <span class="drop-notify__value timer-days">--</span>
            <span class="drop-notify__label">DAYS</span>
          </div>
          <div class="drop-notify__unit">
            <span class="drop-notify__value timer-hrs">--</span>
            <span class="drop-notify__label">HRS</span>
          </div>
          <div class="drop-notify__unit">
            <span class="drop-notify__value timer-mins">--</span>
            <span class="drop-notify__label">MINS</span>
          </div>
          <div class="drop-notify__unit">
            <span class="drop-notify__value timer-secs">--</span>
            <span class="drop-notify__label">SECS</span>
          </div>
        </div>
      </div>
    {% endif %}

    <div class="drop-notify__form">
      {%- form 'customer', id: 'notify-form-{{ block.id }}' -%}
        <input type="hidden" name="contact[tags]" value="notify-me">
        <input
          type="hidden"
          name="contact[note][product]"
          value="{{ product.title | escape }}"
        >
        <p class="drop-notify__form-label">
          {{ block.settings.form_heading | default: 'Notify me when available' }}
        </p>
        <div class="drop-notify__input-group">
          <label for="notify-email-{{ block.id }}" class="visually-hidden"> Email address </label>
          <input
            id="notify-email-{{ block.id }}"
            type="email"
            name="contact[email]"
            class="drop-notify__input"
            placeholder="{{ block.settings.placeholder | default: 'your@email.com' }}"
            autocomplete="email"
            required
            {% if form.errors %}
              aria-invalid="true"
            {% endif %}
          >
          <button type="submit" class="drop-notify__submit button">
            {{ block.settings.button_label | default: 'Notify Me' }}
          </button>
        </div>

        {%- if form.posted_successfully? -%}
          <p class="drop-notify__success">
            ✓ {{ block.settings.success_message | default: "You're on the list. We'll let you know when it drops." }}
          </p>
        {%- endif -%}

        {%- if form.errors -%}
          <p class="drop-notify__error">
            {{ form.errors.translated_fields.email | capitalize }}
            {{ form.errors.messages.email }}
          </p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .drop-notify {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .drop-notify__countdown {
    background: #111111;
    color: #fff;
    padding: 32px;
    border-radius: 2px;
    border-left: 3px solid #fff;
  }

  .drop-notify__eyebrow {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.55;
    margin: 0 0 6px;
  }

  .drop-notify__date {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0 0 20px;
  }

  .drop-notify__timer {
    display: flex;
    gap: 0;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 4px;
    overflow: hidden;
  }

  .drop-notify__unit {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 16px 8px;
    border-right: 1px solid rgba(255, 255, 255, 0.12);
  }

  .drop-notify__unit:last-child {
    border-right: none;
  }

  .drop-notify__value {
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .drop-notify__label {
    font-size: 0.5625rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    opacity: 0.5;
    margin-top: 6px;
  }

  .drop-notify__form-label {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    margin: 0 0 12px;
    text-transform: uppercase;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    opacity: 0.6;
  }

  .drop-notify__input-group {
    display: flex;
    gap: 8px;
  }

  .drop-notify__input {
    flex: 1;
    padding: 12px 14px;
    border: 1px solid #e0e0e0;
    border-radius: 2px;
    font-size: 0.875rem;
    background: #fff;
    color: #0f0f0f;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .drop-notify__input:focus {
    border-color: #0f0f0f;
  }

  .drop-notify__submit {
    white-space: nowrap;
    padding: 12px 20px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    border-radius: 2px;
    cursor: pointer;
  }

  .drop-notify__success {
    font-size: 0.8125rem;
    color: #2a7a2a;
    margin: 10px 0 0;
    font-weight: 500;
  }

  .drop-notify__error {
    font-size: 0.8125rem;
    color: #c0392b;
    margin: 10px 0 0;
  }

  @media screen and (max-width: 749px) {
    .drop-notify__input-group {
      flex-direction: column;
    }

    .drop-notify__submit {
      width: 100%;
    }
  }
{% endstylesheet %}

<script>
  (function () {
    var container = document.getElementById('drop-notify-timer-{{ block.id }}');
    if (!container) return;

    var releaseDate = new Date(container.dataset.release);
    if (isNaN(releaseDate)) return;

    function pad(n) {
      return n < 10 ? '0' + n : n;
    }

    function tick() {
      var now = new Date();
      var diff = releaseDate - now;

      if (diff <= 0) {
        container.querySelector('.timer-days').textContent = '00';
        container.querySelector('.timer-hrs').textContent = '00';
        container.querySelector('.timer-mins').textContent = '00';
        container.querySelector('.timer-secs').textContent = '00';
        return;
      }

      var days = Math.floor(diff / (1000 * 60 * 60 * 24));
      var hrs = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      var mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      var secs = Math.floor((diff % (1000 * 60)) / 1000);

      container.querySelector('.timer-days').textContent = pad(days);
      container.querySelector('.timer-hrs').textContent = pad(hrs);
      container.querySelector('.timer-mins').textContent = pad(mins);
      container.querySelector('.timer-secs').textContent = pad(secs);

      setTimeout(tick, 1000);
    }

    tick();
  })();
</script>

{% schema %}
{
  "name": "Drop Notify",
  "settings": [
    {
      "type": "text",
      "id": "release_date",
      "label": "Release date",
      "info": "Match format exactly: September 5, 2026 10:00:00",
      "default": "September 5, 2026 10:00:00"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form heading",
      "default": "Notify me when available"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "your@email.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Notify Me"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "You're on the list. We'll let you know when it drops."
    }
  ],
  "presets": [
    {
      "name": "Drop Notify",
      "category": "Drop"
    }
  ]
}
{% endschema %}
